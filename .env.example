# Шаблон переменных окружения. Скопировать в `.env` и заменить значения:
#   Copy-Item .env.example .env
# Файл `.env` в репозиторий не попадает (см. .gitignore).
#
# Сгенерировать случайное значение (32 hex-символа):
#   -join ((1..16 | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) }))

# ── Postgres (общая СУБД для LiteLLM и Langfuse; наружу не слушает) ──
POSTGRES_PASSWORD=замените

# ── LiteLLM proxy ────────────────────────────────────────────────────
# Ключ доступа к прокси. Им же Open WebUI авторизуется как OpenAI-клиент.
LITELLM_MASTER_KEY=sk-замените
# Соль для шифрования ключей провайдеров в базе. Менять нельзя после старта:
# уже сохранённые записи станут нерасшифровываемыми.
LITELLM_SALT_KEY=замените

# ── Langfuse (трейсинг) ──────────────────────────────────────────────
NEXTAUTH_SECRET=замените
LANGFUSE_SALT=замените
LANGFUSE_ENCRYPTION_KEY=замените_64_hex_символа

# Ключи проекта задаются заранее: Langfuse создаёт проект с ними при первом
# старте, поэтому не нужно заходить в UI и переносить ключи в LiteLLM руками.
LANGFUSE_PUBLIC_KEY=pk-lf-замените
LANGFUSE_SECRET_KEY=sk-lf-замените

# Учётная запись, которая создаётся при первом старте Langfuse.
# Домен обязательно с точкой: `local@localhost` Langfuse отвергает
# как невалидный адрес и не стартует вообще.
LANGFUSE_USER_EMAIL=local@local.ai
LANGFUSE_USER_PASSWORD=замените

# ── Open WebUI Pipelines (цепочки моделей) ───────────────────────────
PIPELINES_API_KEY=замените
